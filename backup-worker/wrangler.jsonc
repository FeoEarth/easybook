{
 "name":"easybook-backup",
 "main":"index.mjs",
 "compatibility_date":"2026-10-23",
 "compatibility_flags":["nodejs_compat"],
 "workers_dev":false,
 "observability":{"enabled":true},
 "d1_databases":[
  {"binding":"DB","database_name":"easybook-data","database_id":"af430aed-01b5-41ca-9653-31212bed3f9f"},
  {"binding":"SECURITY_DB","database_name":"easybook-security","database_id":"d1761c2d-6372-489c-ae5e-114f3d5baa80"}
 ],
 "r2_buckets":[{"binding":"ATTACHMENTS","bucket_name":"easybook-attachments"},{"binding":"BACKUPS","bucket_name":"easybook-backups"}],
 "triggers":{"crons":["43 * * * *"]}
}
