{
  "name": "easybook-payments",
  "main": "index.mjs",
  "compatibility_date": "2026-11-16",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false,
      "head_sampling_rate": 1,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1,
      "persist": true
    }
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "easybook-data",
      "database_id": "af430aed-01b5-41ca-9653-31212bed3f9f"
    },
    {
      "binding": "SECURITY_DB",
      "database_name": "easybook-security",
      "database_id": "d1761c2d-6372-489c-ae5e-114f3d5baa80"
    }
  ],
  "keep_vars": true,
  "services": [
    {
      "binding": "COLLECTION_SCHEDULER",
      "service": "easybook-collections",
      "entrypoint": "CollectionScheduler"
    }
  ],
  "workers_dev": false,
  "preview_urls": false
}
