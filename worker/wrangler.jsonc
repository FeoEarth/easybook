{
  "name": "easybook-sync",
  "main": "index.mjs",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "keep_vars": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true
  },
  "r2_buckets": [
    {
      "binding": "ATTACHMENTS",
      "bucket_name": "easybook-attachments"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "easybook-data",
      "database_id": "af430aed-01b5-41ca-9653-31212bed3f9f"
    },
    {
      "binding": "SECURITY_DB",
      "database_name": "easybook-security",
      "database_id": "d1761c2d-6372-489c-ae5e-114f3d5baa80",
      "migrations_dir": "security-migrations"
    }
  ],
  "assets": {
    "directory": "../app/src/main/assets/pdf",
    "binding": "PDF_ASSETS",
    "run_worker_first": true
  },
  "triggers": {
    "crons": [
      "17 * * * *"
    ]
  },
  "services": [
    {
      "binding": "IDENTITY_SERVICE",
      "service": "easybook-mcp-oauth"
    }
  ]
}
