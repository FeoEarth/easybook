{
  "name": "easybook-sync",
  "main": "index.mjs",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "r2_buckets": [
    {
      "binding": "ATTACHMENTS",
      "bucket_name": "easybook-attachments"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "easybook-data",
      "database_id": "af430aed-01b5-41ca-9653-31212bed3f9f"
    }
  ],
  "assets": {
    "directory": "../app/src/main/assets/pdf",
    "binding": "PDF_ASSETS",
    "run_worker_first": true
  }
}
