{
  "name": "easybook",
  "version": "0.8.0-test",
  "description": "参考 iOS 备忘录布局的轻量 Android 文本笔记应用，使用 Cloudflare Workers + D1 跨设备同步。",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build:editor": "node scripts/build-editor.mjs && node scripts/generate-ui.mjs && npm run build:pdf",
    "test": "node scripts/check.mjs && node scripts/document-test.mjs && node scripts/rich-editor-test.mjs && node scripts/format-editor-test.mjs && node scripts/worker-integration.mjs && node scripts/web-store-test.mjs && node scripts/attachment-test.mjs",
    "test:editor": "node scripts/format-editor-test.mjs && node scripts/rich-editor-test.mjs",
    "test:management": "node scripts/note-management-api-test.mjs && node scripts/note-management-ui-test.cjs",
    "test:notes": "node scripts/note-management-ui-test.cjs && node scripts/note-browsing-test.cjs && node scripts/note-management-native-bridge-test.mjs",
    "test:media": "node scripts/media-sync-test.mjs && node scripts/attachment-test.mjs",
    "test:sync-ui": "node scripts/sync-page-test.mjs",
    "build:pdf": "node scripts/prepare-pdf.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-code": "3.32.0",
    "@tiptap/extension-task-item": "3.32.0",
    "@tiptap/extension-task-list": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "dompurify": "3.4.17",
    "esbuild": "0.28.2",
    "markdown-it": "14.1.0",
    "pdfjs-dist": "6.4.299"
  },
  "devDependencies": {
    "fake-indexeddb": "6.2.4",
    "jsdom": "30.1.3",
    "playwright": "1.64.1"
  },
  "private": true
}
